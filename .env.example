# Copia in apps/web/.env.local. Le CLI leggono la shell, non questo file.
# pnpm preflight verifica la produzione; pnpm preflight --local ammette fallback.
# Tutto è opzionale in locale: senza chiavi Avanti usa
# PGlite su disco, storage su disco e analisi euristiche al posto dell'AI.

# Postgres in produzione con TLS (Neon Frankfurt consigliato, Supabase, …). Vuoto = PGlite in ./.data/pglite
DATABASE_URL=
# Pool per processo/istanza, non per richiesta (1–50); budget totale = istanze × pool.
DATABASE_POOL_MAX=5
# Timeout SQL in ms; non includono la coda Node in attesa di connessione.
DATABASE_STATEMENT_TIMEOUT_MS=15000
DATABASE_LOCK_TIMEOUT_MS=3000
# startup: Postgres diretto; role: pooler che rifiuta parametri di startup.
# Con role impostare i timeout sul ruolo DB prima del deploy (vedi load-postgres.md).
DATABASE_TIMEOUT_MODE=startup

# Eval live 15/10/2026: A testo p50 1228 ms, ripieghi 1/74; stress 8×40 p50 1064 ms, 0/40 ripieghi.
# AI opzionale: provider selezionato esplicitamente; nessuna chiave = euristica.
AI_PROVIDER=none
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AI_GATEWAY_API_KEY=
AI_MODEL_FAST=deepseek/deepseek-v4.1-flash
AI_MODEL_REASONING=deepseek/deepseek-v4.1-flash
AI_MODEL_VISION=openai/gpt-6-luna
AI_MODEL_FALLBACKS=openai/gpt-6-luna
AI_MODEL_AUDIO=google/gemini-3.5-flash-lite
# OpenRouter strict invia data_collection=deny e zdr=true. Non allenta mai al retry.
AI_DATA_POLICY=strict
AI_REASONING_FAST=off
AI_REASONING_REASONING=minimal
AI_REASONING_VISION=minimal
AI_ATTEMPT_TIMEOUT_MS_FAST=6000
AI_ATTEMPT_TIMEOUT_MS_REASONING=25000
AI_ATTEMPT_TIMEOUT_MS_VISION=20000
# Tetto totale globale; il runtime limita anche a 2 timeout di livello + 500 ms.
AI_TOTAL_TIMEOUT_MS=45000
AI_MAX_ATTEMPTS=3
AI_MONTHLY_BUDGET_EUR=50
# Stima EUR per milione di token: adeguare al prezzo dei modelli scelti.
AI_INPUT_EUR_PER_MILLION=3
AI_OUTPUT_EUR_PER_MILLION=15
# Prezzi per modello, EUR/M input e output. I globali restano il fallback per ID non elencati.
AI_PRICES='{"deepseek/deepseek-v4.1-flash":[0.03,0.70],"openai/gpt-6-luna":[0.10,0.50]}'
# Legacy: AI_ATTEMPT_TIMEOUT_MS imposta i tre livelli se manca l'override specifico.
# Legacy: AI_MODEL_TEXT e AI_GATEWAY_PROVIDER restano letti con avviso preflight.
# Solo prove sintetiche gratuite: AI_PROVIDER=openrouter AI_DATA_POLICY=permissive,
# AI_MODEL_FAST=nvidia/nemotron-3-super-120b-a12b:free,
# AI_MODEL_VISION=google/gemma-4-31b-it:free, AI_MODEL_FALLBACKS=openrouter/free.
# AI_LIVE=1 abilita soltanto le CLI eval/stress, mai i test automatici.

# Vercel Blob per i documenti. Vuoto = disco locale in ./.data/uploads
BLOB_READ_WRITE_TOKEN=

# URL pubblico, usato per generare i link cittadino.
PUBLIC_APP_URL=http://localhost:3400

# Segreto HMAC stabile, almeno 32 byte casuali (64 cifre hex), obbligatorio in produzione; non esporlo al browser.
RATE_LIMIT_SECRET=

# Solo dietro un proxy fidato: ultimo hop di x-forwarded-for; su Vercel x-real-ip.
TRUST_PROXY=0

# Sportello demo mostrato nella landing ("Prova la demo dal telefono"). Solo con dati demo.
NEXT_PUBLIC_DEMO_OFFICE_SLUG=demo-milano-centro

# Autenticazione cron: altro segreto di 32 byte casuali, distinto da RATE_LIMIT_SECRET.
# Schedule giornaliero UTC in apps/web/vercel.json; Pro può usare ogni minuto.
CRON_SECRET=

# Cifratura TOTP AES-256-GCM: 32 byte casuali in hex, distinto dagli altri segreti.
# Obbligatorio in produzione. Locale: chiave persistente .data/mfa-encryption.key (0600).
MFA_ENCRYPTION_KEY=
# Email di servizio: console registra SOLO tipo e ID; non invia email. Nessuna chiave in locale.
NOTIFY_PROVIDER=console
# Per invio reale: NOTIFY_PROVIDER=resend, dominio mittente verificato sul provider.
RESEND_API_KEY=
NOTIFY_FROM=
LEADS_NOTIFY_EMAIL=
# AES-256-GCM: 32 byte casuali in hex (64 cifre), distinto dagli altri segreti.
# Obbligatorio in produzione anche con console. Locale: generato in .data/notify.key (0600).
NOTIFY_ENCRYPTION_KEY=

# Versione mostrata solo agli admin; su Vercel il commit usa VERCEL_GIT_COMMIT_SHA.
# Facoltative: SHA Git esadecimale e tag SemVer; valori non validi vengono omessi.
APP_COMMIT=
APP_TAG=
