# Copia in apps/web/.env.local. Tutto è opzionale in locale: senza chiavi Avanti usa
# PGlite su disco, storage su disco e analisi euristiche al posto dell'AI.

# Postgres in produzione (Neon, Supabase, …). Vuoto = PGlite in ./.data/pglite
DATABASE_URL=

# Vercel AI Gateway. Vuoto = intake e controllo documenti euristici.
AI_GATEWAY_API_KEY=
# Un solo provider autorizzato: niente fallback Gateway verso altri fornitori.
AI_GATEWAY_PROVIDER=anthropic
AI_MODEL_TEXT=anthropic/claude-sonnet-5.5
AI_MODEL_VISION=anthropic/claude-sonnet-5.5

# Vercel Blob per i documenti. Vuoto = disco locale in ./.data/uploads
BLOB_READ_WRITE_TOKEN=

# URL pubblico, usato per generare i link cittadino.
PUBLIC_APP_URL=http://localhost:3400

# Solo dietro un proxy che sostituisce x-forwarded-for (automatico su Vercel).
TRUST_PROXY=0
