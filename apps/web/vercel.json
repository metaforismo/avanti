{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["fra1"],
  "crons": [
    {
      "path": "/api/cron/maintenance",
      "schedule": "0 3 * * *"
    }
  ],
  "installCommand": "cd ../.. && pnpm install --frozen-lockfile",
  "buildCommand": "cd ../.. && pnpm preflight && pnpm db:migrate && pnpm db:check && pnpm build"
}
