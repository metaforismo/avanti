{
  "name": "avanti",
  "private": true,
  "description": "Avanti — il front office AI per CAF e patronati",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@avanti/web",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "turbo run lint typecheck test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @avanti/db generate",
    "db:migrate": "pnpm --filter @avanti/db migrate",
    "db:seed": "pnpm --filter @avanti/db seed"
  },
  "devDependencies": {
    "prettier": "^3.6.0",
    "prettier-plugin-tailwindcss": "^0.7.0",
    "turbo": "^2.11.7",
    "typescript": "^5.9.0"
  }
}
