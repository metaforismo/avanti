{
  "name": "avanti",
  "private": true,
  "description": "Avanti \u2014 il front office AI per CAF e patronati",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@avanti/web",
    "build": "pnpm preflight --local && turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "turbo run lint typecheck test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @avanti/db generate",
    "db:migrate": "pnpm --filter @avanti/db migrate",
    "db:seed": "pnpm --filter @avanti/db seed",
    "db:check": "pnpm --filter @avanti/db check",
    "preflight": "pnpm --filter @avanti/db preflight",
    "admin:bootstrap": "pnpm --filter @avanti/api admin:bootstrap",
    "admin:export": "pnpm --filter @avanti/api admin:export",
    "db:seed:volume": "pnpm --filter @avanti/db seed:volume",
    "bench:api": "pnpm --filter @avanti/api bench",
    "bench:load": "pnpm --filter @avanti/api bench:load",
    "ai:eval": "pnpm --filter @avanti/ai eval",
    "ai:stress": "pnpm --filter @avanti/ai stress"
  },
  "devDependencies": {
    "prettier": "^3.6.0",
    "prettier-plugin-tailwindcss": "^0.7.0",
    "turbo": "^2.11.7",
    "typescript": "^5.9.0"
  }
}
