{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": [
        "DATABASE_URL",
        "DATABASE_POOL_MAX",
        "DATABASE_STATEMENT_TIMEOUT_MS",
        "DATABASE_LOCK_TIMEOUT_MS",
        "DATABASE_TIMEOUT_MODE",
        "BLOB_READ_WRITE_TOKEN",
        "AI_GATEWAY_API_KEY",
        "AI_GATEWAY_PROVIDER",
        "AI_MODEL_TEXT",
        "AI_MODEL_VISION",
        "PUBLIC_APP_URL",
        "RATE_LIMIT_SECRET",
        "MFA_ENCRYPTION_KEY",
        "TRUST_PROXY",
        "CRON_SECRET",
        "NOTIFY_PROVIDER",
        "NOTIFY_FROM",
        "NOTIFY_ENCRYPTION_KEY",
        "RESEND_API_KEY",
        "LEADS_NOTIFY_EMAIL",
        "VERCEL",
        "VERCEL_ENV",
        "VERCEL_GIT_COMMIT_SHA",
        "APP_COMMIT",
        "APP_TAG",
        "NEXT_PUBLIC_DEMO_OFFICE_SLUG",
        "AI_PROVIDER",
        "OPENROUTER_API_KEY",
        "OPENAI_API_KEY",
        "ANTHROPIC_API_KEY",
        "AI_MODEL_FAST",
        "AI_MODEL_REASONING",
        "AI_MODEL_FALLBACKS",
        "AI_DATA_POLICY",
        "AI_MONTHLY_BUDGET_EUR",
        "AI_ATTEMPT_TIMEOUT_MS",
        "AI_TOTAL_TIMEOUT_MS",
        "AI_MAX_ATTEMPTS",
        "AI_INPUT_EUR_PER_MILLION",
        "AI_OUTPUT_EUR_PER_MILLION",
        "AI_REASONING_FAST",
        "AI_REASONING_REASONING",
        "AI_REASONING_VISION",
        "AI_ATTEMPT_TIMEOUT_MS_FAST",
        "AI_ATTEMPT_TIMEOUT_MS_REASONING",
        "AI_ATTEMPT_TIMEOUT_MS_VISION",
        "AI_PRICES"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "typecheck": {},
    "test": {
      "env": ["AVANTI_TEST_DATABASE_URL"],
      "outputs": []
    }
  }
}
