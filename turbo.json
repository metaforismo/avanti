{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": [
        "DATABASE_URL",
        "BLOB_READ_WRITE_TOKEN",
        "AI_GATEWAY_API_KEY",
        "AI_GATEWAY_PROVIDER",
        "AI_MODEL_TEXT",
        "AI_MODEL_VISION",
        "PUBLIC_APP_URL",
        "RATE_LIMIT_SECRET",
        "TRUST_PROXY",
        "CRON_SECRET",
        "VERCEL",
        "VERCEL_ENV",
        "VERCEL_GIT_COMMIT_SHA",
        "APP_COMMIT",
        "APP_TAG",
        "NEXT_PUBLIC_DEMO_OFFICE_SLUG"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "typecheck": {},
    "test": {
      "outputs": []
    }
  }
}
